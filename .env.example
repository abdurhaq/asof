# Copy this file to .env and fill in the values.

# Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Neo4j AuraDB Free (https://console.neo4j.io). Leave NEO4J_URI empty to use the in-memory graph.
NEO4J_URI=
# Copy all four values from the credentials .txt file Aura gave you (newer instances use the instance id as username)
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true
TOP_K=6
